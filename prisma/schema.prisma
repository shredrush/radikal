// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  GUIDE
  ADMIN
  ADMAX
  SUPPORT
  FINANCE
  CONTENT
}

enum TripType {
  TREK
  BIKE
  SNOWBOARD
  SKI
  ROCKCLIMB
  EXPEDITION
  YOGA
}

// Traveller-facing categories used to tag/filter trips.
enum TripCategory {
  ADVENTURE_ENTHUSIAST
  WOMEN_ONLY
  CORPORATE
  LUXURY
  FAMILY
  COURSE
  SELF_GUIDED
  BEGINNER_FRIENDLY
}

// Booking status flow is PENDING -> CONFIRMED -> CANCELLED.
// A booking becomes CONFIRMED only after payment is confirmed
// (Razorpay webhook in production; a dummy payment action for this MVP).
// A CONFIRMED booking whose trip dates have fully passed is persisted as
// COMPLETED (lib/booking-completion.ts flips it lazily when a booking list is
// read, since there is no background scheduler in this app).
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// A support conversation is either open (visible in the support board)
// or closed (resolved). A customer's next message reopens it automatically.
enum SupportChatStatus {
  OPEN
  CLOSED
}

// A guide application starts PENDING and is either APPROVED (which creates a
// live Guide) or REJECTED by an admin.
enum GuideApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A custom trip is booked for a private group or a corporate team instead of a
// fixed, scheduled slot. The traveller describes what they want (sports, dates,
// group size, budget) and a support agent quotes + confirms it over chat.
enum CustomTripGroupType {
  PRIVATE
  CORPORATE
}

// Lifecycle of a custom trip request, driven by the support team.
enum CustomTripStatus {
  NEW
  IN_REVIEW
  QUOTED
  CONFIRMED
  CANCELLED
}

// A guide either proposes a brand-new trip or edits one of their existing trips.
// Both are staged as a reviewable change rather than applied directly.
enum TripChangeType {
  CREATE
  UPDATE
}

// A guide's trip change must be reviewed by a staff member before it goes live.
enum TripChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  // Full phone number in E.164 format (e.g. +917217217678), collected at
  // signup with a per-country dial-code dropdown.
  phone        String?
  // Public, lowercase-alphanumeric handle. For guide accounts it doubles as
  // the guide's public URL segment (e.g. /tenzin). Uniqueness is enforced by a
  // DB constraint; the app layer additionally validates the format, length and
  // reserved-name rules (see lib/sanitize.ts).
  username     String?   @unique
  passwordHash String
  role         UserRole  @default(USER)
  image        String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings                  Booking[]
  wishlistItems             WishlistItem[]
  reviews                   Review[]
  guide                     Guide?
  guideApplications         GuideApplication[]
  reviewedGuideApplications GuideApplication[]  @relation("GuideApplicationReviewedBy")
  supportChat               SupportChat?
  supportMessages           SupportMessage[]
  cancelledBookings         Booking[]           @relation("BookingCancelledBy")
  deletedBookings           Booking[]           @relation("BookingDeletedBy")
  passwordResetOtps         PasswordResetOtp[]
  activityLogs              ActivityLog[]
  customTripRequests        CustomTripRequest[]
  customTripMessages        CustomTripMessage[]
  notifications             Notification[]
  tripChangesSubmitted      TripChangeRequest[] @relation("TripChangeSubmittedBy")
  tripChangesReviewed       TripChangeRequest[] @relation("TripChangeReviewedBy")
  usernameAliases           UsernameAlias[]

  // Role-based lookups: admin user filtering and the guide-orphan checks
  // (users with the GUIDE role but no linked guide profile).
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

// A retired username kept so the guide's previous public URL keeps resolving.
// When a guide-linked user renames, the old handle is stored here and the
// /[guideId] route redirects it to the current username.
model UsernameAlias {
  id        String   @id @default(cuid())
  username  String   @unique
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("username_aliases")
}

// A short-lived one-time password reset code. Only the bcrypt hash of the
// 6-digit code is stored, so a database leak can't be replayed to reset a
// password. Codes are single-use, expire after 5 minutes, and lock out after
// too many failed verification attempts.
model PasswordResetOtp {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, expiresAt])
  @@map("password_reset_otps")
}

model Guide {
  id              String    @id @default(cuid())
  userId          String    @unique
  name            String
  bio             String
  photo           String?
  photos          String[]  @default([])
  videos          String[]  @default([])
  mediaOrder      String[]  @default([])
  location        String
  experienceYears Int       @default(0)
  languages       String[]
  instagramUrl    String?
  facebookUrl     String?
  youtubeUrl      String?
  websiteUrl      String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user           User                @relation(fields: [userId], references: [id])
  certifications Certification[]
  trips          Trip[]
  reviews        Review[]
  tripChanges    TripChangeRequest[]
  tripDrafts     TripDraft[]

  @@index([deletedAt])
  @@map("guides")
}

// Certifications by IMF (Indian Mountaineering Foundation) and other bodies.
model Certification {
  id            String   @id @default(cuid())
  guideId       String
  issuingBody   String // e.g. "Indian Mountaineering Foundation (IMF)", "ABVIMAS"
  title         String
  yearIssued    Int?
  credentialUrl String?
  createdAt     DateTime @default(now())

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

// A user's application to become a vetted guide, reviewed by an admin.
model GuideApplication {
  id              String                 @id @default(cuid())
  userId          String
  name            String
  phone           String?
  location        String
  bio             String
  experienceYears Int                    @default(0)
  languages       String[]
  photo           String?
  photos          String[]               @default([])
  videos          String[]               @default([])
  mediaOrder      String[]               @default([])
  instagramUrl    String?
  facebookUrl     String?
  youtubeUrl      String?
  websiteUrl      String?
  status          GuideApplicationStatus @default(PENDING)
  submittedAt     DateTime               @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user           User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy     User?                           @relation("GuideApplicationReviewedBy", fields: [reviewedById], references: [id])
  certifications GuideApplicationCertification[]

  @@index([status])
  @@index([userId])
  @@map("guide_applications")
}

// Certifications listed on a guide application, stored as structured rows so an
// approving admin can promote them straight onto the new Guide record.
model GuideApplicationCertification {
  id            String   @id @default(cuid())
  applicationId String
  issuingBody   String
  title         String
  yearIssued    Int?
  credentialUrl String?
  createdAt     DateTime @default(now())

  application GuideApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("guide_application_certifications")
}

model Trip {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  type          TripType
  categories    TripCategory[]
  location      String
  description   String
  priceInRupees Int
  durationDays  Int            @default(1)
  images        String[]
  videos        String[]       @default([])
  mediaOrder    String[]       @default([])
  maxGroupSize  Int            @default(8)
  guideId       String?
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  guide         Guide?              @relation(fields: [guideId], references: [id])
  slots         Slot[]
  bookings      Booking[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  tripLocation  TripLocation?
  inclusions    TripInclusion[]
  highlights    TripHighlight[]
  tripChanges   TripChangeRequest[]

  @@index([type])
  @@index([guideId])
  @@index([deletedAt])
  @@map("trips")
}

model TripLocation {
  id        String   @id @default(cuid())
  tripId    String   @unique
  pickup    String
  drop      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_locations")
}

model TripInclusion {
  id        String   @id @default(cuid())
  tripId    String
  item      String
  included  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_inclusions")
}

model TripHighlight {
  id        String   @id @default(cuid())
  tripId    String
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_highlights")
}

// A bookable date instance of a trip. Never let `booked` exceed
// `capacity` — always check availability inside a transaction before
// confirming a booking.
model Slot {
  id              String    @id @default(cuid())
  tripId          String
  date            DateTime
  capacity        Int
  booked          Int       @default(0)
  reserved        Int       @default(0)
  deletedAt       DateTime?
  deletedWithTrip Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tripId])
  @@index([date])
  @@index([deletedAt])
  @@map("slots")
}

model Booking {
  id                   String        @id @default(cuid())
  userId               String
  tripId               String
  slotId               String
  status               BookingStatus @default(PENDING)
  paymentTransactionId String?
  participantCount     Int           @default(1)
  totalPriceRupees     Int
  // Audit trail for cancellations: who cancelled and in which role, so the
  // support board can show exactly who cancelled a booking.
  cancelledById        String?
  cancelledByRole      UserRole?
  cancellationReason   String?
  deletedAt            DateTime?
  deletedWithTrip      Boolean       @default(false)
  deletedById          String?
  deletedByRole        UserRole?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user        User  @relation(fields: [userId], references: [id])
  trip        Trip  @relation(fields: [tripId], references: [id])
  slot        Slot  @relation(fields: [slotId], references: [id])
  cancelledBy User? @relation("BookingCancelledBy", fields: [cancelledById], references: [id])
  deletedBy   User? @relation("BookingDeletedBy", fields: [deletedById], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([userId, deletedAt, createdAt])
  @@index([userId, status, deletedAt, createdAt])
  @@index([slotId])
  @@index([status])
  @@index([tripId])
  @@index([deletedAt])
  @@index([deletedById])
  @@map("bookings")
}

// A traveller's saved trip. One row per user+trip; the composite unique
// constraint makes the pair idempotent so toggling the heart never duplicates.
model WishlistItem {
  id              String    @id @default(cuid())
  userId          String
  tripId          String
  deletedAt       DateTime?
  deletedWithTrip Boolean   @default(false)
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([userId, tripId])
  @@index([userId])
  @@index([userId, deletedAt, createdAt])
  @@index([tripId])
  @@index([deletedAt])
  @@map("wishlist_items")
}

model Review {
  id              String    @id @default(cuid())
  userId          String
  tripId          String?
  guideId         String?
  rating          Int
  comment         String
  deletedAt       DateTime?
  deletedWithTrip Boolean   @default(false)
  createdAt       DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id])
  trip  Trip?  @relation(fields: [tripId], references: [id])
  guide Guide? @relation(fields: [guideId], references: [id])

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([tripId])
  @@index([guideId])
  @@index([deletedAt])
  @@map("reviews")
}

// A single support thread per customer. Support agents see every OPEN thread
// in the board and reply from there. Closing a chat marks it resolved;
// the next customer message reopens it.
model SupportChat {
  id                 String            @id @default(cuid())
  userId             String            @unique
  status             SupportChatStatus @default(OPEN)
  customerLastReadAt DateTime?
  // Set when the customer soft-deletes ("marks as resolved") their own support
  // thread. The row is kept so the support dashboard can show it under a
  // "Resolved" section, but it is hidden from the customer until they message
  // again, which clears it and reopens the thread.
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  @@index([status])
  @@index([userId, deletedAt])
  @@index([updatedAt])
  @@map("support_chats")
}

model SupportMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  chat   SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User        @relation(fields: [senderId], references: [id])

  @@index([chatId])
  @@index([chatId, createdAt])
  @@index([senderId])
  @@map("support_messages")
}

// A traveller's request for a bespoke trip (private group or corporate booking)
// instead of a scheduled slot. Each request gets its own chat thread so the
// support team can discuss requirements and quote a price.
model CustomTripRequest {
  id               String              @id @default(cuid())
  userId           String
  groupType        CustomTripGroupType
  sports           String[]            @default([])
  startDate        DateTime
  endDate          DateTime
  location         String
  participantCount Int                 @default(1)
  budgetRupees     Int?
  requirements     String?
  status           CustomTripStatus    @default(NEW)
  // Set when the customer soft-deletes their request from the chat page. The
  // row is kept so the support dashboard can show it under a "Deleted"
  // section, but it is hidden everywhere customer-facing.
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat CustomTripChat?

  @@index([userId])
  @@index([userId, deletedAt, createdAt])
  @@index([status])
  @@index([updatedAt])
  @@map("custom_trip_requests")
}

// One chat thread per custom trip request.
model CustomTripChat {
  id        String   @id @default(cuid())
  requestId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request  CustomTripRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  messages CustomTripMessage[]

  @@map("custom_trip_chats")
}

model CustomTripMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  chat   CustomTripChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User           @relation(fields: [senderId], references: [id])

  @@index([chatId])
  @@index([senderId])
  @@map("custom_trip_messages")
}

// Append-only audit trail of a user's in-app actions (signup, login, booking,
// payment, support, and admin edits). Stores the client IP and user agent so
// admins can review where and how each action was performed.
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  label     String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

// A guide's proposed trip change (new trip or edit) awaiting staff review.
// `proposed` holds the full trip snapshot the guide wants; `original` holds the
// pre-change snapshot for UPDATE changes so the admin UI can render a diff.
model TripChangeRequest {
  id            String           @id @default(cuid())
  type          TripChangeType
  guideId       String
  tripId        String?
  proposed      Json
  original      Json?
  status        TripChangeStatus @default(PENDING)
  submittedById String
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  guide       Guide? @relation(fields: [guideId], references: [id], onDelete: Cascade)
  trip        Trip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  submittedBy User   @relation("TripChangeSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  User?  @relation("TripChangeReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([guideId])
  @@index([tripId])
  @@map("trip_change_requests")
}

// A guide's in-progress trip draft, saved mid-form for later completion.
// Unlike a TripChangeRequest (a full proposal staged for review), a draft may
// be partial — guides can save once at least 3 fields are filled.
model TripDraft {
  id            String         @id @default(cuid())
  guideId       String
  title         String?
  type          TripType       @default(TREK)
  location      String?
  description   String?
  priceInRupees Int            @default(0)
  durationDays  Int            @default(1)
  maxGroupSize  Int            @default(8)
  categories    TripCategory[]
  images        String[]
  videos        String[]       @default([])
  mediaOrder    String[]       @default([])
  pickup        String?
  drop          String?
  inclusions    String[]
  exclusions    String[]
  highlights    String[]
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId])
  @@index([deletedAt])
  @@map("trip_drafts")
}

// A short-lived, token-protected preview of a trip being drafted or a guide
// trip change pending review. The random 32-byte token is the bearer
// credential; `expiresAt` bounds its lifetime to a few minutes. Expired rows
// are deleted lazily each time a preview is created. Rendered by
// /preview/[token] with a bare-minimum page and caching disabled, so expiry is
// always enforced server-side.
model TripPreview {
  id        String   @id @default(cuid())
  token     String   @unique
  proposed  Json
  context   Json?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@map("trip_previews")
}

// In-app notification for a user (e.g. staff being told a guide trip change
// awaits review). Read state is tracked via `readAt`.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
