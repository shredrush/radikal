// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  GUIDE
  ADMIN
  SUPPORT
}

enum ActivityType {
  TREK
  BIKE
  SNOWBOARD
  SKI
  ROCKCLIMB
  EXPEDITION
  YOGA
}

// Traveller-facing categories used to tag/filter trips.
enum TripCategory {
  ADVENTURE_ENTHUSIAST
  WOMEN_ONLY
  CORPORATE
  LUXURY
  FAMILY
  COURSE
  SELF_GUIDED
  BEGINNER_FRIENDLY
}

// Booking status flow is strictly PENDING -> CONFIRMED -> CANCELLED.
// A booking becomes CONFIRMED only after payment is confirmed
// (Razorpay webhook in production; a dummy payment action for this MVP).
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// A support conversation is either open (visible in the support dashboard)
// or closed (resolved). A customer's next message reopens it automatically.
enum SupportChatStatus {
  OPEN
  CLOSED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings         Booking[]
  reviews          Review[]
  guide            Guide?
  supportChat      SupportChat?
  supportMessages  SupportMessage[]

  @@map("users")
}

// A certified local guide. Optionally linked to a User account so a guide
// can log in and manage their own page in the future.
model Guide {
  id              String   @id @default(cuid())
  userId          String?  @unique
  name            String
  slug            String   @unique
  bio             String
  photo           String?
  location        String
  experienceYears Int      @default(0)
  languages       String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User?           @relation(fields: [userId], references: [id])
  certifications Certification[]
  activities     Activity[]
  reviews        Review[]

  @@map("guides")
}

// Certifications by IMF (Indian Mountaineering Foundation) and other bodies.
model Certification {
  id            String   @id @default(cuid())
  guideId       String
  issuingBody   String // e.g. "Indian Mountaineering Foundation (IMF)", "ABVIMAS"
  title         String
  yearIssued    Int?
  credentialUrl String?
  createdAt     DateTime @default(now())

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model Activity {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  type          ActivityType
  categories    TripCategory[]
  location      String
  description   String
  priceInRupees Int
  durationDays  Int            @default(1)
  images        String[]
  maxGroupSize  Int            @default(8)
  guideId       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  guide        Guide?          @relation(fields: [guideId], references: [id])
  slots        Slot[]
  bookings     Booking[]
  reviews      Review[]
  tripLocation TripLocation?
  inclusions   TripInclusion[]
  highlights   TripHighlight[]

  @@map("activities")
}

model TripLocation {
  id         String   @id @default(cuid())
  activityId String   @unique
  pickup     String
  drop       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("trip_locations")
}

model TripInclusion {
  id         String   @id @default(cuid())
  activityId String
  item       String
  included   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("trip_inclusions")
}

model TripHighlight {
  id         String   @id @default(cuid())
  activityId String
  text       String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("trip_highlights")
}

// A bookable date instance of an activity. Never let `booked` exceed
// `capacity` — always check availability inside a transaction before
// confirming a booking.
model Slot {
  id         String   @id @default(cuid())
  activityId String
  date       DateTime
  capacity   Int
  booked     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([activityId])
  @@map("slots")
}

model Booking {
  id               String        @id @default(cuid())
  userId           String
  activityId       String
  slotId           String
  status           BookingStatus @default(PENDING)
  participantCount Int           @default(1)
  totalPriceRupees Int
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  activity Activity @relation(fields: [activityId], references: [id])
  slot     Slot     @relation(fields: [slotId], references: [id])

  @@index([userId])
  @@index([slotId])
  @@map("bookings")
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  activityId String?
  guideId    String?
  rating     Int
  comment    String
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  activity Activity? @relation(fields: [activityId], references: [id])
  guide    Guide?    @relation(fields: [guideId], references: [id])

  @@map("reviews")
}

// A single support thread per customer. Support agents see every OPEN thread
// in the dashboard and reply from there. Closing a chat marks it resolved;
// the next customer message reopens it.
model SupportChat {
  id        String            @id @default(cuid())
  userId    String            @unique
  status    SupportChatStatus @default(OPEN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  @@index([status])
  @@map("support_chats")
}

model SupportMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  chat   SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User        @relation(fields: [senderId], references: [id])

  @@index([chatId])
  @@index([senderId])
  @@map("support_messages")
}
