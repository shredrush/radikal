generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  guide        Guide?
  reviews      Review[]

  @@map("users")
}

model Guide {
  id              String          @id @default(cuid())
  userId          String?         @unique
  name            String
  slug            String          @unique
  bio             String
  photo           String?
  location        String
  experienceYears Int             @default(0)
  languages       String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  activities      Activity[]
  certifications  Certification[]
  user            User?           @relation(fields: [userId], references: [id])
  reviews         Review[]

  @@map("guides")
}

model Certification {
  id            String   @id @default(cuid())
  guideId       String
  issuingBody   String
  title         String
  yearIssued    Int?
  credentialUrl String?
  createdAt     DateTime @default(now())
  guide         Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model Activity {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  type          ActivityType
  categories    TripCategory[]
  location      String
  description   String
  priceInRupees Int
  durationDays  Int            @default(1)
  difficulty    Difficulty     @default(MODERATE)
  images        String[]
  maxGroupSize  Int            @default(8)
  isCustom      Boolean        @default(false)
  guideId       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  guide         Guide?         @relation(fields: [guideId], references: [id])
  bookings      Booking[]
  reviews       Review[]
  slots         Slot[]

  @@map("activities")
}

model Slot {
  id         String    @id @default(cuid())
  activityId String
  date       DateTime
  capacity   Int
  booked     Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  bookings   Booking[]
  activity   Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("slots")
}

model Booking {
  id               String        @id @default(cuid())
  userId           String
  activityId       String
  slotId           String
  status           BookingStatus @default(PENDING)
  participantCount Int           @default(1)
  totalPriceRupees Int
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  activity         Activity      @relation(fields: [activityId], references: [id])
  slot             Slot          @relation(fields: [slotId], references: [id])
  user             User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([slotId])
  @@map("bookings")
}

model Review {
  id         String    @id @default(cuid())
  userId     String
  activityId String?
  guideId    String?
  rating     Int
  comment    String
  createdAt  DateTime  @default(now())
  activity   Activity? @relation(fields: [activityId], references: [id])
  guide      Guide?    @relation(fields: [guideId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@map("reviews")
}

enum UserRole {
  USER
  GUIDE
  ADMIN
}

enum ActivityType {
  SKI
  SNOWBOARD
  BIKE
  TREK
}

enum Difficulty {
  BEGINNER
  MODERATE
  EXTREME
}

enum TripCategory {
  ADVENTURE_ENTHUSIAST
  WOMEN_ONLY
  CORPORATE
  LUXURY
  FOR_FAMILY
  COURSES
  SELF_GUIDED
  BEGINNER_FRIENDLY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
