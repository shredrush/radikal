# Database
# Direct database URL used by Prisma migrations and other Prisma CLI commands.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Runtime application URL. For Supabase use the Transaction pooler connection
# string (port 6543), not the Session pooler (port 5432), so serverless
# instances do not exhaust the session-pool client limit.
DATABASE_POOL_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Runtime fallback when a pooler URL is not configured.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Keep this at 1 in serverless environments; each function instance owns a pool.
DATABASE_POOL_MAX=1

# Authentication and site URL
AUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=https://example.com

# Supabase Storage
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Transactional email
RESEND_API_KEY=re_replace-with-api-key
RESEND_FROM_EMAIL=Radikal <trips@example.com>

#Protomaps
PROTOMAPS_API_KEY=replace-with-protomaps-api-key

# Scheduled endpoints
CRON_SECRET=replace-with-a-random-secret

# Upstash Redis (server-side rate limiting)
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# Optional dedicated HMAC secret; AUTH_SECRET is used when omitted.
RATE_LIMIT_SECRET=replace-with-a-random-secret
# Set only to a header that your hosting proxy strips and sets itself.
TRUSTED_PROXY_IP_HEADER=x-vercel-forwarded-for

# Sentry build integration (store the token only in CI/deployment secrets)
SENTRY_AUTH_TOKEN=replace-with-sentry-auth-token
